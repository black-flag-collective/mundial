{
  "name": "@mundial/ui",
  "version": "0.1.0",
  "description": "Mundial design system — the World Cup 2026 tracker's UI as a reusable React component library.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist"
  ],
  "main": "./dist/mundial-ui.js",
  "module": "./dist/mundial-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mundial-ui.js"
    },
    "./styles": "./dist/mundial-ui.css",
    "./styles.css": "./dist/mundial-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.128"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.4.6",
    "three": "^0.185.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-dts": "^5.0.3"
  }
}