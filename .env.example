# Anthropic API key for the match-data updater (scripts/update-data.js).
# In production this lives as a GitHub Actions secret, not here — the scheduled
# "Update match data" workflow uses it. Set it locally only if you want to run
# the updater by hand: `node scripts/update-data.js`.
# The web server itself does NOT need this key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default port (3000)
# PORT=3000
