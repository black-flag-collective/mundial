# Anthropic API key. Two uses:
#   1. The scheduled match-data updater (scripts/update-data.js) — runs as a
#      GitHub Actions secret, not from here. Set it locally only to run the
#      updater by hand: `node scripts/update-data.js`.
#   2. The web server's on-demand "Buzz Oracle" prediction (/api/predict). If set
#      as a Fly secret, the Oracle button turns on; if unset, it's hidden and the
#      app is unaffected. The Oracle is cost-bounded (cheap model, cached,
#      rate-limited, daily-capped) and only calls out when a user asks.
ANTHROPIC_API_KEY=sk-ant-...

# Buzz Oracle knobs (all optional — on-demand AI prediction; very low cost).
# X_PREDICT_MODEL=claude-haiku-4-5   # cheapest model; override if desired
# X_PREDICT_CACHE_MS=300000          # reuse one prediction for 5m (the big saver)
# X_PREDICT_RATE_MS=15000            # per-client min interval between fresh calls
# X_PREDICT_DAILY_CAP=500            # max AI calls/UTC-day (circuit breaker)
# X_PREDICT_MAX_TOKENS=320           # response budget

# X (Twitter) API bearer token for the live buzz layer.
# Optional — when unset, the buzz layer runs on a simulated signal and the app
# works normally. In production this lives as a Fly secret.
# X_BEARER_TOKEN=

# Live buzz source. With a token set, the default is the cost-bounded "counts"
# mode: it asks X only HOW MANY posts match per team (no post bodies), scoped to
# teams whose match is live right now, and makes ZERO requests when nothing is
# live. Set X_BUZZ_MODE=stream ONLY to opt into the firehose (billed per post).
# X_BUZZ_MODE=stream

# Counts-mode cost/cadence knobs (all optional — sensible defaults shown).
# Polling is driven by the match clock: fast while a match is live, a
# request-free re-check otherwise. The daily cap is a hard circuit breaker.
# X_COUNTS_LIVE_INTERVAL_MS=60000     # poll cadence for nations in a LIVE match (60s)
# X_COUNTS_SLOW_INTERVAL_MS=300000    # poll cadence for warmup/cooldown nations (5m)
# X_COUNTS_IDLE_INTERVAL_MS=600000    # request-free re-check when nothing is live (10m)
# X_COUNTS_WINDOW_MIN=10              # recent-volume window per poll
# X_COUNTS_MATCH_MIN=150             # how long after kickoff a match stays "live"
# X_COUNTS_WARMUP_MIN=0              # pre-kickoff hype window (off by default)
# X_COUNTS_COOLDOWN_MIN=30           # post-match reaction window
# X_COUNTS_DAILY_CAP=2000            # max requests/UTC-day before pausing

# Firehose stream-mode knobs (only used when X_BUZZ_MODE is NOT "counts").
# X_STREAM_DISABLED=1                # force the stream off (e.g. on secondary machines)
# X_STREAM_STALL_MS=30000            # reconnect if the stream is silent this long

# X Trends (/api/trends.json) — what's trending per location. Runs whenever a
# token is set (billed per location, very cheap). All optional.
# X_TRENDS_DISABLED=1                # turn the trends poller off
# X_TRENDS_INTERVAL_MS=600000        # poll cadence (10m — trends move slowly)
# X_TRENDS_DAILY_CAP=800             # max requests/UTC-day (circuit breaker)
# X_TRENDS_WOEIDS=1,23424977,23424900,23424775  # worldwide,USA,Mexico,Canada

# Optional: max concurrent SSE clients on /api/buzz/stream (default 200)
# SSE_MAX_CLIENTS=200

# Optional: override the default port (3000)
# PORT=3000
